[Unit]
Description=Suzu AI-VTuber RVC Voice Conversion Sidecar
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/git/public/Suzu-VTuber-AI
ExecStart=%h/git/public/Suzu-VTuber-AI/sidecars/rvc/.venv/bin/python sidecars/rvc/server.py --host 127.0.0.1 --port 5050
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
